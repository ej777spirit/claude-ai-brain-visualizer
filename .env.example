# Server Configuration
# API server port. Deliberately named API_PORT (not PORT): hosting platforms
# inject PORT, which previously made the API server drift away from the Vite
# proxy target and silently degrade the app to demo mode. The Vite dev proxy
# reads the same variable (vite.config.ts), so client and server cannot drift.
API_PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# API Keys (Keep secure - never commit to version control)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_ai_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
